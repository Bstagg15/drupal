# Ignore directories generated by Composer
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/drush/Commands/contrib/

# Ignore sensitive files and database backups
/web/sites/*/*settings*.php
/web/sites/*/*services*.yml
!.web/sites/development.services.yml

# Ignore user-generated content and files
/web/sites/*/files/
/web/sites/simpletest/
/private/
/public/

# Ignore temporary and cache files
/web/sites/*/tmp/
/web/sites/*/private/
*.log

# Ignore IDE and local development files
.idea/
.vscode/
.DS_Store
Thumbs.db
.ddev/
.env

# Ignore Drush and test artifacts
drush/sites/.checksums
drupal-check-report.xml